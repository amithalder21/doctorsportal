generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

model Appointment {
  id            String            @id @default(cuid())
  name          String
  phone         String
  email         String
  date          DateTime
  time          String
  message       String?
  documentUrl   String?
  status        AppointmentStatus @default(PENDING)
  paymentStatus PaymentStatus     @default(UNPAID)
  transactionId String?
  createdAt     DateTime          @default(now())
  
  // Relations
  userId        String?
  user          User?             @relation("PatientAppointments", fields: [userId], references: [id])
  doctorId      String?
  doctor        User?             @relation("DoctorAppointments", fields: [doctorId], references: [id])
}

enum Role {
  SUPERADMIN
  DOCTOR
  RECEPTION
  PATIENT
}

model User {
  id                 String        @id @default(cuid())
  name               String?
  email              String        @unique
  role               Role          @default(PATIENT)
  createdAt          DateTime      @default(now())
  
  // Relations
  appointments       Appointment[] @relation("PatientAppointments")
  doctorAppointments Appointment[] @relation("DoctorAppointments")
  blockedSlots       BlockedSlot[] @relation("DoctorBlockedSlots")
}

model BlockedSlot {
  id        String   @id @default(cuid())
  date      DateTime
  time      String?  // If null, the entire day is blocked. If string, only that specific time slot is blocked.
  reason    String?  // Optional context for the doctor (e.g., "Surgery", "Vacation")
  
  doctorId  String
  doctor    User     @relation("DoctorBlockedSlots", fields: [doctorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // A doctor cannot have duplicate blocked slot entries for the exact same date and time
  // Note: time is optional, so Prisma allows nulls in unique constraints
  @@unique([date, time, doctorId])
}
